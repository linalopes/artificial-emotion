---
import type { CollectionEntry } from 'astro:content';
import StudyArticle from '../../components/StudyArticle.astro';
import { getPublished } from '../../lib/content';

export async function getStaticPaths() {
  const studies = await getPublished('studies');
  return studies.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'studies'>;
}

const { entry } = Astro.props;
---

<StudyArticle entry={entry} />
