---
/**
 * date: 2026-10-05
 * document: Heartbeat Kinegram
 * role: experimental lab / fabrication tool
 * page: /lab/heartbeat-kinegram/
 *
 * Isolated rotational kinegram study. Not in navigation, not indexed.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CLOCK_PRESETS, DEFAULT_PARAMS, FRAME_CHOICES } from '../../lib/kinegram/types';
---

<!--
  date: 2026-10-05
  document: Heartbeat Kinegram
  role: experimental lab / fabrication tool
  page: /lab/heartbeat-kinegram/
-->
<BaseLayout
  title="Heartbeat Kinegram (lab)"
  description="Rotational kinegram study: a printed cardiac cycle viewed through a rotating radial mask."
  theme="dark"
  noindex
>
  <main class="lab" data-pagefind-ignore="all" data-kinegram>
    <header class="lab__header">
      <p class="label">Lab · prototype</p>
      <h1>Heartbeat Kinegram</h1>
      <p class="lab__lede">
        Rotational kinegram study for translating a cardiac cycle into a physical optical animation.
        A stationary encoded image is viewed through a rotating radial mask, allowing a mechanical
        clock movement to produce the appearance of a beating anatomical heart.
      </p>
      <p class="lab__note">
        The image is not animated by a screen. Motion is encoded physically into the printed layers.
        The goal is a convincing kinetic effect on a real clock movement, not a medically realistic cycle.
      </p>
    </header>

    <div class="kine">
      <div class="kine__stage" data-kine-canvas aria-label="Heartbeat kinegram simulator"></div>

      <div class="kine__panel">
        <p class="kine__state" data-kine-state>State 1 / 6 — Open</p>
        <p class="kine__hint">Visual motion state — not a medical phase.</p>

        <fieldset class="kine__fieldset">
          <legend>Preview</legend>
          <div class="kine__tabs" role="toolbar" aria-label="Preview mode">
            <button type="button" data-kine-preview="composite" aria-pressed="true">Composite</button>
            <button type="button" data-kine-preview="base" aria-pressed="false">Base</button>
            <button type="button" data-kine-preview="mask" aria-pressed="false">Mask</button>
            <button type="button" data-kine-preview="source" aria-pressed="false">Source frame</button>
          </div>
        </fieldset>

        <fieldset class="kine__fieldset">
          <legend>Rotation</legend>
          <p class="kine__angle">Angle: <output data-kine-angle>0.0°</output></p>
          <label class="kine__row">
            <span>Angle</span>
            <input data-kine-rotation type="range" min="0" max="360" step="0.1" value="0" />
          </label>
          <div class="kine__actions">
            <button type="button" data-kine-tick-back>−6° Clock tick</button>
            <button type="button" data-kine-tick>＋6° Clock tick</button>
          </div>
          <div class="kine__actions">
            <button type="button" data-kine-snap>Snap to frame</button>
            <button type="button" data-kine-prev>Prev frame</button>
            <button type="button" data-kine-next>Next frame</button>
          </div>
          <p class="kine__hint">
            Rotate the mask manually, or step it using the controls. A standard ticking quartz second hand
            advances by 6° per second. Use the clock-tick buttons to test whether the current encoding works
            well with a real clock mechanism.
          </p>
        </fieldset>

        <fieldset class="kine__fieldset">
          <legend>Clock Compatibility</legend>
          <dl class="kine__stats">
            <div><dt>Clock tick</dt><dd data-kine-clock-tick>6°</dd></div>
            <div><dt>Encoding step</dt><dd data-kine-clock-step>6.0°</dd></div>
            <div><dt>Total encoded positions</dt><dd data-kine-clock-positions>60</dd></div>
            <div><dt>Frames advanced per clock tick</dt><dd data-kine-clock-advance>1.0</dd></div>
          </dl>
          <p class="kine__status kine__status--good" data-kine-clock-status>
            This encoding aligns cleanly with a 6° quartz tick.
          </p>
          <p class="kine__hint" data-kine-clock-note>
            Each second advances one encoded position — one visual state.
          </p>
          <details class="kine__details">
            <summary>What happens with a real clock?</summary>
            <p>
              When driven by a real quartz second-hand clock movement, the mask does not move continuously.
              It jumps 6° once per second. That means some encodings work better than others. If the encoded
              angular step does not align well with 6°, the animation may skip states or appear less smooth.
            </p>
            <p>
              The goal of this lab is not a medically realistic systole/diastole simulation. The goal is to
              find a visual encoding that produces a convincing kinetic effect when printed and driven by a
              real mechanism.
            </p>
          </details>
        </fieldset>

        <fieldset class="kine__fieldset">
          <legend>Encoding</legend>
          <label class="kine__row">
            <span>Frames</span>
            <select data-kine-frames>
              {FRAME_CHOICES.map((n) => (
                <option value={n} selected={n === DEFAULT_PARAMS.frames}>
                  {n}
                </option>
              ))}
            </select>
          </label>
          <p class="kine__hint">Frames = the number of different visual states encoded into the disc.</p>
          <label class="kine__row">
            <span>Slices per frame <output data-kine-slices-out>{DEFAULT_PARAMS.slices}</output></span>
            <input
              data-kine-slices
              type="range"
              min="5"
              max="28"
              step="1"
              value={DEFAULT_PARAMS.slices}
            />
          </label>
          <p class="kine__hint">
            Slices per frame = how many times each frame is repeated around the circle. More slices can
            improve continuity, but they also change how the design behaves with a real clock tick.
          </p>
          <dl class="kine__stats">
            <div>
              <dt>Total encoded positions</dt>
              <dd data-kine-positions>{DEFAULT_PARAMS.frames} × {DEFAULT_PARAMS.slices} = {DEFAULT_PARAMS.frames * DEFAULT_PARAMS.slices}</dd>
            </div>
            <div>
              <dt>Encoding step angle</dt>
              <dd data-kine-step>6.0° per position</dd>
            </div>
          </dl>
          <p class="kine__preset-label">Clock-friendly presets</p>
          <div class="kine__actions" role="group" aria-label="Clock-friendly presets">
            {CLOCK_PRESETS.map((preset) => (
              <button
                type="button"
                data-kine-preset={`${preset.frames},${preset.slices}`}
                aria-pressed={preset.frames === DEFAULT_PARAMS.frames && preset.slices === DEFAULT_PARAMS.slices ? 'true' : 'false'}
              >
                {preset.frames} × {preset.slices}{preset.frames === 6 && preset.slices === 10 ? ' · rec.' : ''}
              </button>
            ))}
          </div>
          <p class="kine__hint">These presets align exactly with a 6° quartz second-hand tick.</p>
        </fieldset>

        <fieldset class="kine__fieldset">
          <legend>Physical</legend>
          <label class="kine__row">
            <span>Disc diameter <output data-kine-diameter-out>{DEFAULT_PARAMS.diameterMm} mm</output></span>
            <input
              data-kine-diameter
              type="range"
              min="80"
              max="180"
              step="1"
              value={DEFAULT_PARAMS.diameterMm}
            />
          </label>
          <label class="kine__row">
            <span>Center guide <output data-kine-guide-out>{DEFAULT_PARAMS.guideMm} mm</output></span>
            <input
              data-kine-guide
              type="range"
              min="1"
              max="12"
              step="0.5"
              value={DEFAULT_PARAMS.guideMm}
            />
          </label>
          <p class="kine__warn" data-kine-a4-fit hidden>
            Two discs at this diameter no longer fit on one A4 sheet at 1:1. Disc SVGs remain correct.
          </p>
        </fieldset>

        <fieldset class="kine__fieldset">
          <legend>Export</legend>
          <div class="kine__actions kine__actions--stack">
            <button type="button" class="kine__primary" data-kine-export-a4>Export A4 Test Sheet SVG</button>
            <button type="button" data-kine-export-base>Export Base SVG</button>
            <button type="button" data-kine-export-mask>Export Mask SVG</button>
          </div>
        </fieldset>

        <aside class="kine__fab">
          <p><strong>Base:</strong> Print on white paper.</p>
          <p><strong>Mask:</strong> Print on transparent inkjet film using black ink.</p>
          <p><strong>Print at:</strong> 100% / Actual Size. Do not Fit to Page.</p>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { mountHeartbeatKinegram } from '../../scripts/heartbeat-kinegram-client';
  const root = document.querySelector<HTMLElement>('[data-kinegram]');
  if (root) mountHeartbeatKinegram(root);
</script>

<style>
  .lab {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-4) var(--page-gutter) var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .lab__header {
    display: grid;
    gap: var(--space-1);
  }

  .lab__header h1 {
    font-size: var(--text-xl);
    color: var(--accent);
  }

  .lab__lede,
  .lab__note {
    color: var(--fg-muted);
    max-width: 62ch;
  }

  .lab__note {
    font-size: var(--text-sm);
  }

  .kine {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .kine {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      gap: var(--space-4);
    }
  }

  .kine__stage {
    width: min(100%, 72dvh, 44rem);
    aspect-ratio: 1 / 1;
    justify-self: center;
    background: var(--bg);
    touch-action: none;
  }

  .kine__stage :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    cursor: grab;
  }

  .kine__stage :global(canvas:active) {
    cursor: grabbing;
  }

  .kine__panel {
    display: grid;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .kine__state {
    font-family: var(--font-title);
    font-size: var(--text-lg);
    color: var(--accent-alt);
    max-width: none;
    margin-bottom: 0;
  }

  .kine__angle {
    font-family: var(--font-title);
    font-size: var(--text-lg);
    color: var(--fg);
    max-width: none;
  }

  .kine__angle output {
    font-family: var(--font-mono);
  }

  .kine__stats {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .kine__stats > div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: none;
  }

  .kine__stats dt {
    color: var(--fg-muted);
  }

  .kine__stats dd {
    margin: 0;
    text-align: right;
    color: var(--fg);
  }

  .kine__status {
    max-width: none;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--rule);
  }

  .kine__status--good {
    border-color: var(--accent-alt);
    color: var(--accent-alt);
  }

  .kine__status--mixed {
    color: var(--fg);
  }

  .kine__status--poor {
    border-color: var(--accent);
    color: var(--accent);
  }

  .kine__preset-label {
    margin: 0.2rem 0 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--fg-muted);
    max-width: none;
  }

  .kine__details {
    max-width: none;
  }

  .kine__details summary {
    cursor: pointer;
    color: var(--fg);
  }

  .kine__details p {
    margin-top: 0.5rem;
    max-width: none;
    color: var(--fg-muted);
  }

  .kine__fieldset {
    border: 1px solid var(--rule);
    padding: 0.85rem 0.9rem 1rem;
    display: grid;
    gap: 0.65rem;
    min-width: 0;
  }

  .kine__fieldset legend {
    padding-inline: 0.35rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .kine__tabs,
  .kine__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .kine__actions--stack {
    flex-direction: column;
    align-items: stretch;
  }

  .kine__row {
    display: grid;
    gap: 0.35rem;
    max-width: none;
  }

  .kine__row span {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .kine__row input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }

  .kine__row select {
    font: inherit;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--rule);
    padding: 0.35rem 0.5rem;
    max-width: 8rem;
  }

  .kine__panel button {
    font: inherit;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--fg-muted);
    padding: 0.4rem 0.7rem;
    cursor: pointer;
  }

  .kine__panel button:hover,
  .kine__panel button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .kine__primary {
    border-color: var(--accent-alt) !important;
    color: var(--accent-alt) !important;
  }

  .kine__hint,
  .kine__warn,
  .kine__fab p {
    max-width: none;
    color: var(--fg-muted);
  }

  .kine__warn {
    color: var(--accent);
  }

  .kine__fab {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.85rem;
  }

  .kine__fab strong {
    color: var(--fg);
    font-weight: var(--weight-mono-regular);
  }
</style>
