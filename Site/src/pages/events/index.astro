---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatEventTime, getPublishedByDate, isoDate } from '../../lib/content';
import { entryPath, mediaSrc } from '../../lib/paths';
import { COLLECTION_LABELS, EVENT_TYPE_LABELS } from '../../lib/vocabulary';

const title = COLLECTION_LABELS.events;
const events = (await getPublishedByDate('events')).map((entry) => {
  const { data } = entry;
  return {
    href: entryPath('events', entry.id),
    title: data.title,
    cover: data.cover?.trim() ? mediaSrc(data.cover.trim()) : undefined,
    typeLabel: data.eventType ? EVENT_TYPE_LABELS[data.eventType] : undefined,
    datetime: isoDate(data.date),
    date: formatDate(data.date),
    time: formatEventTime(data.startTime, data.endTime),
    location: data.location?.trim() || undefined,
    lede: data.lede?.trim() || undefined,
    status: data.status,
  };
});
---

<BaseLayout title={title}>
  <main class="container event-index">
    <header class="event-index__header">
      <h1>{title}</h1>
      <p class="event-index__lede">Public moments in the research.</p>
    </header>

    {
      events.length === 0 ? (
        <p class="label">Nothing published yet.</p>
      ) : (
        <ol class="event-index__list">
          {events.map((event) => (
            <li>
              <a class="event-index__card" href={event.href}>
                {event.cover ? (
                  <img class="event-index__media" src={event.cover} alt="" />
                ) : (
                  <span class="event-index__media event-index__media--ph" aria-hidden="true"></span>
                )}

                <span class="event-index__body">
                  {event.typeLabel && <span class="event-index__type">{event.typeLabel}</span>}
                  <span class="event-index__name">{event.title}</span>
                  <span class="event-index__when">
                    <time datetime={event.datetime}>{event.date}</time>
                    {event.time && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <span>{event.time}</span>
                      </>
                    )}
                  </span>
                  {event.location && <span class="event-index__place">{event.location}</span>}
                  {event.lede && <span class="event-index__summary">{event.lede}</span>}
                  <span class="event-index__foot">
                    <span class="event-index__status">{event.status}</span>
                    <span class="event-index__go" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="12" height="12">
                        <path
                          d="M7 12h10M13 7l5 5-5 5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</BaseLayout>

<style>
  .event-index {
    display: grid;
    gap: var(--space-5);
  }

  .event-index__header {
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
  }

  .event-index__header h1 {
    font-size: clamp(1.85rem, 1.3rem + 1.6vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .event-index__header h1::after {
    content: '';
    display: block;
    width: 2.35rem;
    height: 1px;
    margin-top: 0.85rem;
    background: var(--color-pink);
  }

  .event-index__lede {
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .event-index__list {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .event-index__list > li {
    max-width: none;
  }

  .event-index__card {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.35fr) minmax(0, 0.65fr);
    min-height: 12.5rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--color-white) 86%, transparent);
    border: 1px solid var(--color-gray-green);
    border-radius: 2px;
    overflow: hidden;
  }

  .event-index__card:hover,
  .event-index__card:focus-visible {
    color: inherit;
  }

  .event-index__card:focus-visible {
    outline: 2px solid var(--color-pink);
    outline-offset: 3px;
  }

  .event-index__media {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 12.5rem;
    object-fit: cover;
    align-self: stretch;
  }

  .event-index__media--ph {
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--color-gray-green) 55%, var(--color-white)) 0%,
        color-mix(in srgb, var(--color-turquoise) 12%, var(--color-white)) 100%
      );
  }

  .event-index__body {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.4rem;
    padding: 1rem 1.05rem 0.9rem;
    min-width: 0;
  }

  .event-index__type,
  .event-index__when,
  .event-index__place,
  .event-index__status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-index__type {
    color: var(--color-link);
  }

  .event-index__when,
  .event-index__place,
  .event-index__status {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .event-index__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .event-index__status {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .event-index__name {
    position: relative;
    width: max-content;
    max-width: 100%;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    color: var(--fg);
  }

  .event-index__name::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.08em;
    width: 100%;
    height: 1px;
    background: var(--color-pink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.32s ease;
  }

  .event-index__card:hover .event-index__name::after,
  .event-index__card:focus-visible .event-index__name::after {
    transform: scaleX(1);
  }

  .event-index__summary {
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .event-index__go {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    color: var(--fg-muted);
    border: 1px solid var(--rule);
    border-radius: 50%;
    transition:
      border-color 0.28s ease,
      color 0.28s ease;
  }

  .event-index__card:hover .event-index__go,
  .event-index__card:focus-visible .event-index__go {
    border-color: var(--color-pink);
    color: var(--color-pink);
  }

  @media (max-width: 39.99rem) {
    .event-index__card {
      grid-template-columns: 1fr;
    }

    .event-index__media {
      min-height: 11rem;
      aspect-ratio: 16 / 10;
      height: auto;
    }

    .event-index__body {
      padding: 0.95rem 0.95rem 0.85rem;
    }
  }
</style>
