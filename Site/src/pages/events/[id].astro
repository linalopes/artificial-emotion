---
import type { CollectionEntry } from 'astro:content';
import EventArticle from '../../components/EventArticle.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content';

export async function getStaticPaths() {
  const events = await getPublished('events');
  return events.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'events'>;
}

const { entry } = Astro.props;
const description = entry.data.lede;
---

<BaseLayout title={entry.data.title} description={description}>
  <main>
    <EventArticle entry={entry} />
  </main>
</BaseLayout>
