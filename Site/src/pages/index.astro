---
import AboutSection from '../components/AboutSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConstellationSection from '../components/ConstellationSection.astro';
import CurrentPublic from '../components/CurrentPublic.astro';
import GenerativeWaves from '../components/GenerativeWaves.astro';
import LatestStudies from '../components/LatestStudies.astro';
import { threadPath } from '../lib/paths';
import type { ResearchThread } from '../lib/vocabulary';

const indexLines = ['Bodies', 'Machines', 'Materials', 'Emotions', 'in circulation'];

const threads: {
  id: ResearchThread;
  n: string;
  title: string;
  lede: string;
}[] = [
  {
    id: 'soft-mechanisms',
    n: '01',
    title: 'Soft Mechanisms',
    lede: 'Compliant materials, adaptive structures, soft robotics.',
  },
  {
    id: 'kinetic-studies',
    n: '02',
    title: 'Kinetic Studies',
    lede: 'Movement, weight, balance and temporal behavior.',
  },
  {
    id: 'heartbeat-biosignals',
    n: '03',
    title: 'Heartbeat & Biosignals',
    lede: 'Sensing, rhythms, physiological data and affect.',
  },
];
---

<BaseLayout header="publication">
  <main class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__field" aria-hidden="true">
        <GenerativeWaves mode="fill" />
      </div>
      <div class="hero__veil" aria-hidden="true"></div>

      <div class="hero__stage">
        <header class="hero__copy">
          <h1 class="hero__title" id="hero-title">
            Artificial <span class="hero__word">Emotion</span>
          </h1>
          <p class="hero__lede">
            Research into soft mechanisms, kinetic behavior and bodily rhythms.
          </p>
        </header>

        <p class="hero__index">
          <span class="hero__index-rule" aria-hidden="true"></span>
          {
            indexLines.map((line) => (
              <span class="hero__index-line">{line}</span>
            ))
          }
        </p>

        <a class="hero__scroll" href="#constellation">
          <span class="visually-hidden">Continue to the research constellation</span>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path
              d="M12 5v12M7 13l5 5 5-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>

        <ul class="hero__threads">
          {
            threads.map((thread) => (
              <li>
                <a class="thread-card" href={threadPath(thread.id)}>
                  <span class="thread-card__media" aria-hidden="true"></span>
                  <span class="thread-card__body">
                    <span class="thread-card__num">{thread.n}</span>
                    <span class="thread-card__title">{thread.title}</span>
                    <span class="thread-card__lede">{thread.lede}</span>
                    <span class="thread-card__go" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="12" height="12">
                        <path
                          d="M7 12h10M13 7l5 5-5 5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <CurrentPublic />
    <LatestStudies />
    <AboutSection />

    <ConstellationSection />
  </main>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }


  .hero {
    position: relative;
    display: grid;
    overflow-x: hidden;
    min-height: 0;
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: clamp(45rem, 80dvh, 51.25rem);
    }
  }

  .hero__field,
  .hero__veil {
    position: absolute;
    pointer-events: none;
  }

  .hero__field {
    z-index: 0;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
  }

  @media (min-width: 40rem) {
    .hero__field {
      left: 16%;
      width: 94%;
    }
  }

  .hero__veil {
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        var(--color-white) 0%,
        color-mix(in srgb, var(--color-white) 86%, transparent) 16%,
        color-mix(in srgb, var(--color-white) 28%, transparent) 40%,
        transparent 58%
      ),
      radial-gradient(
        ellipse 50% 48% at 10% 22%,
        color-mix(in srgb, var(--color-white) 78%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-white) 12%, transparent) 0%,
        transparent 16%,
        transparent 78%,
        color-mix(in srgb, var(--color-white) 55%, transparent) 100%
      );
  }

  @media (max-width: 39.99rem) {
    .hero__veil {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-white) 62%, transparent) 0%,
          color-mix(in srgb, var(--color-white) 28%, transparent) 28%,
          transparent 52%,
          color-mix(in srgb, var(--color-white) 40%, transparent) 100%
        ),
        radial-gradient(
          ellipse 90% 40% at 18% 18%,
          color-mix(in srgb, var(--color-white) 70%, transparent) 0%,
          transparent 70%
        );
    }
  }

  .hero__stage {
    position: relative;
    z-index: 2;
    display: grid;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-5) var(--page-gutter) var(--space-5);
    min-height: inherit;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    align-items: start;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-4);
    grid-column: 1;
    grid-row: 1;
    padding-top: var(--space-2);
  }

  .hero__title {
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(2.8rem, 12vw, 4rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: var(--accent);
  }

  .hero__word {
    display: block;
  }

  .hero__lede {
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.2rem);
    line-height: var(--leading-snug);
    max-width: 34ch;
  }

  .hero__index {
    display: none;
  }

  .hero__scroll {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: var(--space-5);
    margin-bottom: var(--space-5);
    color: var(--fg);
    border: 1px solid var(--fg);
    border-radius: 50%;
    text-decoration: none;
  }

  .hero__scroll:hover {
    background: color-mix(in srgb, var(--color-white) 55%, transparent);
  }

  .hero__threads {
    list-style: none;
    padding: 0;
    margin: 0;
    grid-column: 1;
    grid-row: 3;
    display: grid;
    gap: 1rem;
  }

  .hero__threads > li {
    display: grid;
    min-width: 0;
  }

  .thread-card {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100%;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--color-white) 78%, transparent);
    border: 1px solid var(--color-gray-green);
    border-radius: 2px;
    overflow: hidden;
  }

  .thread-card:hover {
    background: color-mix(in srgb, var(--color-white) 90%, transparent);
  }

  .thread-card:hover .thread-card__go {
    border-color: var(--fg);
    color: var(--fg);
  }

  .thread-card__media {
    display: block;
    min-height: 8.5rem;
    aspect-ratio: 16 / 10;
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--color-gray-green) 42%, var(--color-white)) 0%,
        color-mix(in srgb, var(--color-gray-green) 16%, var(--color-white)) 100%
      );
  }

  .thread-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.7rem;
    grid-template-rows: auto auto auto 1fr;
    gap: 0.4rem 0.65rem;
    padding: 1.15rem 1.15rem 1rem;
    min-width: 0;
  }

  .thread-card__num {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .thread-card__title {
    grid-column: 1 / -1;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: var(--text-base);
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
  }

  .thread-card__lede {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
    max-width: 36ch;
  }

  .thread-card__go {
    grid-column: 2;
    grid-row: 4;
    align-self: end;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    margin-top: 0.7rem;
    color: var(--fg-muted);
    border: 1px solid var(--rule);
    border-radius: 50%;
    flex: none;
  }

  @media (min-width: 40rem) {
    .hero__stage {
      grid-template-columns: minmax(0, 1fr) 13rem;
      grid-template-rows: auto 1fr auto;
      padding-block: var(--space-5) var(--space-4);
    }

    .hero__copy {
      gap: var(--space-3);
      padding-top: 0;
    }

    .hero__title {
      font-size: clamp(4.5rem, 7.2vw, 7.5rem);
    }

    .hero__index {
      display: grid;
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      margin: 0;
      padding-top: 0.15rem;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      line-height: 1.9;
      color: var(--fg-muted);
    }

    .hero__index-line {
      display: block;
      white-space: nowrap;
    }

    .hero__index-rule {
      display: block;
      width: 1.6rem;
      height: 2px;
      margin-bottom: 0.7rem;
      background: var(--color-pink);
    }

    .hero__scroll {
      align-self: end;
      margin-top: 0;
      margin-bottom: var(--space-3);
    }

    .hero__threads {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 48rem) {
    .hero__threads {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .thread-card__media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    .thread-card__body {
      padding: 0.85rem 0.85rem 0.75rem;
    }
  }

  @media (min-width: 68.75rem) {
    .thread-card {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
      grid-template-rows: 1fr;
      height: 100%;
      min-height: 9.75rem;
    }

    .thread-card__media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 9.75rem;
      align-self: stretch;
    }

    .thread-card__body {
      padding: 0.85rem 0.95rem 0.75rem;
      min-height: 9.75rem;
    }

    .thread-card__lede {
      padding-right: 0.15rem;
    }
  }

</style>
