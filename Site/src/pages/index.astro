---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConstellationSection from '../components/ConstellationSection.astro';
---

<BaseLayout>
  <main class="page">
    <header class="container intro">
      <h1 class="intro__title">Artificial Emotion</h1>
      <p class="intro__lede">
        Research into movement, soft mechanisms, kinetic behavior and bodily signals.
      </p>
    </header>

    <ConstellationSection />

    <footer class="container colophon">
      <hr />
      <p class="label">Research site in development.</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  /* .container centres with auto margins, which in a flex column would
     shrink it to its content; keep it full width so text stays on the grid. */
  .page > .container {
    width: 100%;
  }

  /* .container brings the gutters; the page gap handles vertical rhythm. */
  .intro {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) 0;
  }

  .intro__title {
    font-size: var(--text-2xl);
    color: var(--accent);
  }

  .intro__lede {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    max-width: 34ch;
  }

  .colophon {
    display: grid;
    gap: var(--space-3);
    padding-block: 0 var(--space-6);
  }
</style>
