---
/**
 * Standalone atelier infrastructure / community funding page.
 * Not a Study, Note, Reference, Event, or Research Thread.
 * Not in main navigation — shared via direct links.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatFundAmount,
  getProjectionScreenFundState,
} from '../../data/projection-screen';
import { href, mediaSrc } from '../../lib/paths';

const fund = getProjectionScreenFundState();
const raisedLabel = formatFundAmount(fund.raised, fund.currency);
const goalLabel = formatFundAmount(fund.goal, fund.currency);
const remainingLabel = formatFundAmount(fund.remaining, fund.currency);
const qrSrc = fund.qrSrc ? mediaSrc(fund.qrSrc) : undefined;

const description =
  'A small collective goal: CHF 460 for a retractable projection screen for the Artificial Emotion atelier in Wetzikon-Zürich.';
---

<BaseLayout title="Atelier Projection Screen" description={description}>
  <main class="screen" data-pagefind-body>
    <header class="screen-hero">
      <div class="screen-hero__inner">
        <p class="label">Atelier infrastructure</p>
        <h1>Atelier Projection Screen</h1>
        <p class="screen-hero__lede">{description}</p>

        <div
          class:list={['screen-fund', fund.complete && 'screen-fund--complete']}
          aria-labelledby="screen-fund-heading"
        >
          {
            fund.complete ? (
              <>
                <h2 class="screen-fund__status" id="screen-fund-heading">
                  Goal reached
                </h2>
                <p class="screen-fund__summary">
                  <span class="screen-fund__raised">{goalLabel}</span>
                  <span class="screen-fund__of">of {goalLabel} funded</span>
                </p>
                <p class="screen-fund__thanks">
                  Thank you. The projection screen has been funded by the Artificial Emotion
                  community.
                </p>
              </>
            ) : (
              <>
                <h2 class="visually-hidden" id="screen-fund-heading">
                  Funding progress
                </h2>
                <p class="screen-fund__summary">
                  <span class="screen-fund__raised">{raisedLabel} raised</span>
                  <span class="screen-fund__of">of {goalLabel}</span>
                </p>
              </>
            )
          }

          <div class="screen-fund__meter">
            <progress
              class="screen-fund__progress"
              value={Math.min(fund.raised, fund.goal)}
              max={fund.goal}
              aria-label={`Funding progress: ${fund.percentLabel}`}
            ></progress>
            <p class="screen-fund__percent">
              <span class="visually-hidden">Progress: </span>
              {fund.percentLabel}
            </p>
          </div>

          {
            !fund.complete && (
              <div class="screen-fund__cta">
                <a
                  class="screen-cta"
                  href={fund.stripeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Contribute
                </a>
                <p class="screen-fund__hint">Choose any amount on Stripe.</p>
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div class="screen-body">
      <section class="screen-section" aria-labelledby="why-heading">
        <h2 id="why-heading">Why a projection screen?</h2>
        <div class="screen-copy">
          <p>
            During the Open Research Studio, it became very clear that the atelier needs a proper
            projection setup.
          </p>
          <p>
            At one point, because we had no screen, I ended up doing a dramatic live reading of the
            subtitles instead.
          </p>
          <p class="screen-aside">Charming once.</p>
          <p class="screen-aside">Probably not a sustainable AV strategy.</p>
          <p>So this is a small experiment in collective infrastructure:</p>
          <ul class="screen-principles">
            <li>One clear goal.</li>
            <li>One concrete object.</li>
            <li>One transparent amount.</li>
          </ul>
        </div>
      </section>

      <section class="screen-section" aria-labelledby="object-heading">
        <h2 id="object-heading">What we are funding</h2>
        <div class="screen-object">
          <p class="screen-object__name">{fund.productName}</p>
          <dl class="screen-specs">
            <div>
              <dt>Projection area</dt>
              <dd>290 × 163 cm</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd>16:9</dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>Motorized / retractable</dd>
            </div>
            <div>
              <dt>Installation</dt>
              <dd>Ceiling-mounted</dd>
            </div>
            <div>
              <dt>Goal</dt>
              <dd>{goalLabel}</dd>
            </div>
          </dl>
          <p>
            <a
              class="screen-link"
              href={fund.productUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              View the screen on Galaxus
            </a>
          </p>
        </div>
      </section>
    </div>

    <section
      class:list={['screen-progress', 'theme-soft', fund.complete && 'screen-progress--complete']}
      aria-labelledby="progress-heading"
    >
      <div class="screen-progress__inner">
        <h2 id="progress-heading">{fund.complete ? 'Goal reached' : 'Progress'}</h2>

        <dl class="screen-progress__stats">
          <div>
            <dt>Raised</dt>
            <dd>{raisedLabel}</dd>
          </div>
          <div>
            <dt>Goal</dt>
            <dd>{goalLabel}</dd>
          </div>
          <div>
            <dt>Remaining</dt>
            <dd>{fund.complete ? formatFundAmount(0, fund.currency) : remainingLabel}</dd>
          </div>
          <div>
            <dt>Progress</dt>
            <dd>{fund.percentLabel}</dd>
          </div>
        </dl>

        <div class="screen-fund__meter screen-fund__meter--band">
          <progress
            class="screen-fund__progress"
            value={Math.min(fund.raised, fund.goal)}
            max={fund.goal}
            aria-label={`Funding progress: ${fund.percentLabel}`}
          ></progress>
        </div>

        {
          fund.complete ? (
            <p class="screen-progress__note">
              {goalLabel} of {goalLabel} funded. Thank you — this campaign is complete.
            </p>
          ) : (
            <p class="screen-progress__note">
              When we reach {goalLabel}, the campaign is complete.
            </p>
          )
        }
      </div>
    </section>

    <div class="screen-body">
      <section class="screen-section" aria-labelledby="contribute-heading">
        <h2 id="contribute-heading">Contribute</h2>
        {
          fund.complete ? (
            <div class="screen-copy">
              <p>
                This specific goal has been reached. Thank you to everyone who contributed toward
                the projection screen.
              </p>
              <p>
                <a
                  class="screen-link screen-link--quiet"
                  href={fund.stripeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Stripe donation page
                </a>
                <span class="screen-muted"> — available if you still want to support the atelier more broadly.</span>
              </p>
            </div>
          ) : (
            <>
              <div class="screen-copy">
                <p>You can contribute any amount via Stripe.</p>
                <p>
                  The suggested contribution is CHF 20, but you can choose your own amount.
                </p>
              </div>

              <div class:list={['screen-contribute', qrSrc && 'screen-contribute--with-qr']}>
                <div class="screen-contribute__primary">
                  <a
                    class="screen-cta"
                    href={fund.stripeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Contribute via Stripe
                  </a>
                  <p class="screen-fund__hint">
                    If you use TWINT and already have my number, you can also contribute there.
                  </p>
                </div>
                {
                  qrSrc && (
                    <figure class="screen-contribute__qr">
                      <img
                        src={qrSrc}
                        alt="QR code to contribute to the atelier projection screen via Stripe"
                        width="180"
                        height="180"
                        decoding="async"
                      />
                      <figcaption>Scan to contribute via Stripe</figcaption>
                    </figure>
                  )
                }
              </div>
            </>
          )
        }
      </section>

      <section class="screen-section" aria-labelledby="support-heading">
        <h2 id="support-heading">Why support this?</h2>
        <div class="screen-copy">
          <p>
            The atelier is currently operating without institutional funding, and I’m experimenting
            with small, transparent ways for the community around the research to help sustain the
            infrastructure that makes gatherings, presentations, workshops, collaborations and open
            research possible.
          </p>
          <p>This screen is intentionally a very specific goal.</p>
          <p>When we reach {goalLabel}, the campaign is complete.</p>
          <p>No vague fundraising. No mysterious budget.</p>
          <p class="screen-aside">Just one projection screen.</p>
        </div>
      </section>

      <section class="screen-section" aria-labelledby="after-heading">
        <h2 id="after-heading">What happens after the goal is reached?</h2>
        <div class="screen-copy">
          <p>
            The screen will become part of the shared infrastructure of the atelier and will be used
            for:
          </p>
          <ul>
            <li>Open Research Studios</li>
            <li>presentations and screenings</li>
            <li>workshops</li>
            <li>community gatherings</li>
            <li>research sessions</li>
            <li>visiting artists and collaborators</li>
            <li>future Artificial Emotion events</li>
          </ul>
          <p>
            Once the goal is reached, this page will remain online as a record of the contribution.
          </p>
          <p class="screen-aside">Funded by the Artificial Emotion community.</p>
        </div>
      </section>

      <section class="screen-section screen-section--secondary" aria-labelledby="other-heading">
        <h2 id="other-heading">Other ways to contribute</h2>
        <div class="screen-copy">
          <p>Money is only one form of contribution.</p>
          <p>
            If you would like to support the research through knowledge, connections, collaboration
            or community, I would also love to hear from you.
          </p>
          <p>Possible contributions include:</p>
          <ul>
            <li>electronics or PCB expertise</li>
            <li>biosignals and heartbeat research</li>
            <li>artistic or technical collaboration</li>
            <li>knowledge about grants, residencies or funding structures</li>
            <li>introducing the project to people or institutions who might be interested</li>
            <li>bringing a research group, community or event to the atelier</li>
          </ul>
          <p>
            The Open Research Studio made something very visible to me: the value of the atelier is
            not only in the objects inside it, but also in the people and networks that meet there.
          </p>
          <p>Or, as someone put it during the event:</p>
          <blockquote>
            <p>not networks — nerdworkings.</p>
          </blockquote>
          <p>I think I’m keeping that.</p>
          <p>Thank you for supporting the space, the research and the people around it.</p>
        </div>
      </section>

      <p class="screen-back">
        <a href={href('/')}>Back to Artificial Emotion</a>
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .screen {
    display: grid;
    gap: 0;
  }

  .screen-hero {
    padding: var(--space-6) var(--page-gutter) var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .screen-hero__inner {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    margin-inline: auto;
  }

  .screen-hero h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 4rem);
    letter-spacing: -0.035em;
  }

  .screen-hero__lede {
    max-width: 36ch;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.35rem);
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
    color: var(--fg-muted);
  }

  .screen-fund {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .screen-fund__status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-mono-regular);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg);
  }

  .screen-fund__summary {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    max-width: none;
  }

  .screen-fund__raised {
    font-family: var(--font-mono);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    letter-spacing: 0.04em;
  }

  .screen-fund__of,
  .screen-fund__percent,
  .screen-fund__hint,
  .screen-muted {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .screen-fund__thanks {
    max-width: 36ch;
    margin: 0;
    color: var(--fg-muted);
  }

  .screen-fund__meter {
    display: grid;
    gap: 0.45rem;
    width: 100%;
  }

  .screen-fund__progress {
    display: block;
    width: 100%;
    height: 0.45rem;
    border: 0;
    border-radius: 0;
    background: color-mix(in srgb, var(--color-deep-purple) 12%, var(--color-white));
    overflow: hidden;
    appearance: none;
  }

  .screen-fund__progress::-webkit-progress-bar {
    background: color-mix(in srgb, var(--color-deep-purple) 12%, var(--color-white));
  }

  .screen-fund__progress::-webkit-progress-value {
    background: var(--color-deep-purple);
  }

  .screen-fund__progress::-moz-progress-bar {
    background: var(--color-deep-purple);
  }

  .theme-soft .screen-fund__progress {
    background: color-mix(in srgb, var(--color-deep-purple) 16%, var(--color-gray-green));
  }

  .theme-soft .screen-fund__progress::-webkit-progress-bar {
    background: color-mix(in srgb, var(--color-deep-purple) 16%, var(--color-gray-green));
  }

  .screen-fund__cta {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
    margin-top: var(--space-1);
  }

  .screen-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1.35rem;
    border: 1px solid var(--fg);
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--weight-mono-regular);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .screen-cta:hover,
  .screen-cta:focus-visible {
    background: transparent;
    color: var(--fg);
    text-decoration: none;
  }

  .screen-body {
    display: grid;
    gap: var(--space-6);
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-6) var(--page-gutter) var(--space-7);
  }

  .screen-section {
    display: grid;
    gap: var(--space-3);
  }

  .screen-section h2 {
    font-size: clamp(1.45rem, 1.15rem + 1vw, 2rem);
    letter-spacing: -0.03em;
  }

  .screen-section--secondary {
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .screen-section--secondary h2 {
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
    color: var(--fg-muted);
  }

  .screen-copy {
    display: grid;
    gap: var(--space-3);
  }

  .screen-copy p,
  .screen-copy li {
    max-width: 38ch;
  }

  .screen-copy ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding-left: 1.15em;
  }

  .screen-aside {
    font-family: var(--font-title);
    font-weight: var(--weight-title-medium);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
  }

  .screen-principles {
    list-style: none;
    padding-left: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .screen-principles li {
    max-width: none;
  }

  .screen-object {
    display: grid;
    gap: var(--space-4);
  }

  .screen-object__name {
    margin: 0;
    max-width: none;
    font-family: var(--font-title);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .screen-specs {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .screen-specs > div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.42fr) minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }

  .screen-specs dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .screen-specs dd {
    margin: 0;
    max-width: none;
  }

  .screen-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .screen-link--quiet {
    color: var(--fg-muted);
  }

  .screen-progress {
    width: 100%;
    padding: var(--space-6) var(--page-gutter);
  }

  .screen-progress__inner {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    margin-inline: auto;
  }

  .screen-progress h2 {
    font-size: clamp(1.45rem, 1.15rem + 1vw, 2rem);
    letter-spacing: -0.03em;
  }

  .screen-progress__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
    margin: 0;
  }

  .screen-progress__stats dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .screen-progress__stats dd {
    margin: 0.2rem 0 0;
    max-width: none;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }

  .screen-progress__note {
    margin: 0;
    max-width: 36ch;
    color: var(--fg-muted);
  }

  .screen-contribute {
    display: grid;
    gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-2);
  }

  .screen-contribute__primary {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .screen-contribute__qr {
    margin: 0;
    width: clamp(10rem, 42vw, 12.5rem);
  }

  .screen-contribute__qr img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border: 1px solid var(--rule);
    background: var(--color-white);
  }

  .screen-contribute__qr figcaption {
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .screen-copy blockquote {
    margin: var(--space-2) 0;
    padding: 0.15em 0 0.15em 1em;
    border-left: 1px solid var(--color-pink);
    font-family: var(--font-title);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
  }

  .screen-copy blockquote p {
    max-width: none;
  }

  .screen-back {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .screen-back a {
    text-decoration-color: var(--link-underline);
  }

  @media (min-width: 40rem) {
    .screen-progress__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .screen-contribute--with-qr {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  @media (max-width: 39.99rem) {
    .screen-specs > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .screen-cta {
      width: 100%;
    }
  }
</style>
