---
import type { CollectionEntry } from 'astro:content';
import ReferenceArticle from '../../components/ReferenceArticle.astro';
import { getPublished } from '../../lib/content';

export async function getStaticPaths() {
  const references = await getPublished('references');
  return references.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'references'>;
}

const { entry } = Astro.props;
---

<ReferenceArticle entry={entry} />
