---
import { render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getPublished } from '../../lib/content';
import { THREAD_LABELS } from '../../lib/vocabulary';

export async function getStaticPaths() {
  const references = await getPublished('references');
  return references.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'references'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<EntryLayout
  collection="references"
  id={entry.id}
  title={data.title}
  related={data.related}
  meta={[
    { label: 'Creator', value: data.creator },
    { label: 'Year', value: data.year },
    { label: 'Type', value: data.referenceType },
    { label: 'Link', value: data.url, href: data.url },
    { label: 'Threads', value: data.threads.map((t) => THREAD_LABELS[t]) },
    { label: 'Tags', value: data.tags },
  ]}
>
  <Content />
</EntryLayout>
