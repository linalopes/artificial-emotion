---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { getPublished, sortByTitle, toListItem } from '../../lib/content';
import { COLLECTION_LABELS } from '../../lib/vocabulary';

const title = COLLECTION_LABELS.references;
const items = sortByTitle(await getPublished('references')).map(toListItem);
---

<BaseLayout title={title}>
  <main class="container">
    <h1>{title}</h1>
    <EntryList items={items} />
  </main>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }
</style>
