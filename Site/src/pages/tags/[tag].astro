---
import ArchiveCard from '../../components/ArchiveCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  formatTagEntrySummary,
  getPublishedByTag,
  getPublishedTagIndex,
  isoDate,
  TAG_COLLECTION_LABELS,
  TAGGED_COLLECTIONS,
  tagDisplayLabel,
  type TagContent,
} from '../../lib/content';
import { entryPath, mediaSrc, tagsPath, threadPath } from '../../lib/paths';
import {
  EVENT_TYPE_LABELS,
  isResearchThread,
  researchLogicalId,
} from '../../lib/vocabulary';

export async function getStaticPaths() {
  const index = await getPublishedTagIndex();
  return index.map((item) => ({
    params: { tag: item.id },
    props: { tag: item.id },
  }));
}

interface Props {
  tag: string;
}

interface TagCard {
  href: string;
  title: string;
  cover?: string;
  coverFit?: 'cover' | 'contain';
  kicker?: string;
  subtitle?: string;
  lede?: string;
  meta?: string;
  datetime?: string;
}

const CONTAIN_COVER_TYPES = new Set(['institution', 'tool', 'software']);

const { tag } = Astro.props;
const content = await getPublishedByTag(tag);
const label = tagDisplayLabel(tag);
const summary = formatTagEntrySummary(content);

function researchCards(entries: TagContent['research']): TagCard[] {
  return entries.flatMap((entry) => {
    const id = researchLogicalId(entry.id);
    if (!isResearchThread(id)) return [];
    const { data } = entry;
    return [
      {
        href: threadPath(id),
        title: data.title.trim(),
        cover: data.cover?.trim() ? mediaSrc(data.cover.trim()) : undefined,
        subtitle: data.subtitle?.trim() || undefined,
        lede: data.lede?.trim() || undefined,
      },
    ];
  });
}

function studyCards(entries: TagContent['studies']): TagCard[] {
  return entries.map((entry) => {
    const { data } = entry;
    return {
      href: entryPath('studies', entry.id),
      title: data.title,
      cover: data.cover?.trim() ? mediaSrc(data.cover.trim()) : undefined,
      kicker: data.status,
      lede: data.lede?.trim() || undefined,
      meta: formatDate(data.date),
      datetime: isoDate(data.date),
    };
  });
}

function noteCards(entries: TagContent['notes']): TagCard[] {
  return entries.map((entry) => {
    const { data } = entry;
    const type = data.type?.trim().toLowerCase() || undefined;
    return {
      href: entryPath('notes', entry.id),
      title: data.title,
      cover: data.cover?.trim() ? mediaSrc(data.cover.trim()) : undefined,
      coverFit: type && CONTAIN_COVER_TYPES.has(type) ? 'contain' : 'cover',
      kicker: data.type?.trim().replace(/-/g, ' ') || undefined,
      lede: data.lede?.trim() || undefined,
    };
  });
}

function referenceCards(entries: TagContent['references']): TagCard[] {
  return entries.map((entry) => {
    const { data } = entry;
    const year =
      data.year !== undefined && String(data.year).trim() ? String(data.year).trim() : undefined;
    const byline = [data.creator?.trim() || undefined, year].filter(Boolean).join(' · ');
    return {
      href: entryPath('references', entry.id),
      title: data.title,
      cover: data.image?.trim() ? mediaSrc(data.image.trim()) : undefined,
      kicker: data.referenceType?.trim().replace(/-/g, ' ') || undefined,
      meta: byline || undefined,
    };
  });
}

function eventCards(entries: TagContent['events']): TagCard[] {
  return entries.map((entry) => {
    const { data } = entry;
    return {
      href: entryPath('events', entry.id),
      title: data.title,
      cover: data.cover?.trim() ? mediaSrc(data.cover.trim()) : undefined,
      kicker: data.eventType ? EVENT_TYPE_LABELS[data.eventType] : undefined,
      lede: data.lede?.trim() || undefined,
      meta: formatDate(data.date),
      datetime: isoDate(data.date),
    };
  });
}

const groups = TAGGED_COLLECTIONS.flatMap((collection) => {
  const entries = content[collection];
  if (entries.length === 0) return [];

  const cards =
    collection === 'research'
      ? researchCards(content.research)
      : collection === 'studies'
        ? studyCards(content.studies)
        : collection === 'notes'
          ? noteCards(content.notes)
          : collection === 'references'
            ? referenceCards(content.references)
            : eventCards(content.events);

  return [
    {
      id: collection,
      label: TAG_COLLECTION_LABELS[collection],
      cards,
    },
  ];
});
---

<BaseLayout title={`${label} — Tags`}>
  <main class="container tag-page">
    <header class="tag-page__header">
      <p class="tag-page__kicker">
        <a href={tagsPath()}>Tag</a>
      </p>
      <h1>{label}</h1>
      <p class="tag-page__summary">{summary}</p>
    </header>

    {
      groups.map((group) => (
        <section class="tag-page__group" aria-labelledby={`tag-${group.id}`}>
          <h2 id={`tag-${group.id}`}>{group.label}</h2>
          <ol class="tag-page__list">
            {group.cards.map((card) => (
              <li>
                <ArchiveCard {...card} />
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .tag-page {
    display: grid;
    gap: var(--space-6);
  }

  .tag-page__header {
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
  }

  .tag-page__kicker {
    margin: 0;
    width: max-content;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .tag-page__kicker a {
    color: inherit;
    text-decoration: none;
  }

  .tag-page__header h1 {
    font-size: clamp(1.85rem, 1.3rem + 1.6vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .tag-page__header h1::after {
    content: '';
    display: block;
    width: 2.35rem;
    height: 1px;
    margin-top: 0.85rem;
    background: var(--color-pink);
  }

  .tag-page__summary {
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .tag-page__group {
    display: grid;
    gap: var(--space-4);
  }

  .tag-page__group h2 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .tag-page__list {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag-page__list > li {
    max-width: none;
  }
</style>
