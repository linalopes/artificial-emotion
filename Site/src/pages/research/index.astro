---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { threadPath } from '../../lib/paths';
import { THREAD_LIST } from '../../lib/vocabulary';

const title = 'Research';
---

<BaseLayout title={title}>
  <main class="container">
    <h1>{title}</h1>
    <p class="intro">Three threads run through the research. Each page gathers the studies, notes and references that belong to it.</p>

    <ol class="threads">
      {
        THREAD_LIST.map((thread) => (
          <li class="thread">
            <h2>
              <a href={threadPath(thread.id)}>{thread.label}</a>
            </h2>
            <p>{thread.description}</p>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .intro {
    color: var(--fg-muted);
    margin-bottom: var(--space-5);
  }

  .threads {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }

  .thread {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .thread h2 {
    font-size: var(--text-xl);
  }

  .thread h2 a {
    text-decoration: none;
  }

  .thread h2 a:hover {
    text-decoration: underline;
  }
</style>
