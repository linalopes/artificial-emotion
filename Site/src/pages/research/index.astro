---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedResearchThreads } from '../../lib/content';
import { mediaSrc, threadPath } from '../../lib/paths';
import { isResearchThread, researchLogicalId } from '../../lib/vocabulary';

const title = 'Research';
const threads = (await getPublishedResearchThreads()).flatMap((entry) => {
  const id = researchLogicalId(entry.id);
  if (!isResearchThread(id)) return [];
  const { data } = entry;
  return [
    {
      href: threadPath(id),
      title: data.title.trim(),
      subtitle: data.subtitle?.trim() || undefined,
      lede: data.lede?.trim() || undefined,
      cover: data.cover?.trim() ? mediaSrc(data.cover.trim()) : undefined,
    },
  ];
});
---

<BaseLayout title={title}>
  <main class="container research-index">
    <header class="research-index__header">
      <h1>{title}</h1>
      <p class="research-index__lede">
        Three threads run through the research. Each page gathers the studies, notes and references
        that belong to it.
      </p>
    </header>

    {
      threads.length === 0 ? (
        <p class="label">Nothing published yet.</p>
      ) : (
        <ol class="research-index__list">
          {threads.map((thread) => (
            <li>
              <a class="research-index__card" href={thread.href}>
                {thread.cover ? (
                  <img class="research-index__media" src={thread.cover} alt="" />
                ) : (
                  <span class="research-index__media research-index__media--ph" aria-hidden="true"
                  ></span>
                )}

                <span class="research-index__body">
                  <span class="research-index__name">{thread.title}</span>
                  {thread.subtitle && <span class="research-index__subtitle">{thread.subtitle}</span>}
                  {thread.lede && <span class="research-index__summary">{thread.lede}</span>}
                  <span class="research-index__foot">
                    <span class="research-index__go" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="12" height="12">
                        <path
                          d="M7 12h10M13 7l5 5-5 5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</BaseLayout>

<style>
  .research-index {
    display: grid;
    gap: var(--space-5);
  }

  .research-index__header {
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
  }

  .research-index__header h1 {
    font-size: clamp(1.85rem, 1.3rem + 1.6vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .research-index__header h1::after {
    content: '';
    display: block;
    width: 2.35rem;
    height: 1px;
    margin-top: 0.85rem;
    background: var(--color-pink);
  }

  .research-index__lede {
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .research-index__list {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .research-index__list > li {
    max-width: none;
  }

  .research-index__card {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.35fr) minmax(0, 0.65fr);
    min-height: 12.5rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--color-white) 86%, transparent);
    border: 1px solid var(--color-gray-green);
    border-radius: 2px;
    overflow: hidden;
  }

  .research-index__card:hover,
  .research-index__card:focus-visible {
    color: inherit;
  }

  .research-index__card:focus-visible {
    outline: 2px solid var(--color-pink);
    outline-offset: 3px;
  }

  .research-index__media {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 12.5rem;
    object-fit: cover;
    align-self: stretch;
  }

  .research-index__media--ph {
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--color-gray-green) 55%, var(--color-white)) 0%,
        color-mix(in srgb, var(--color-turquoise) 12%, var(--color-white)) 100%
      );
  }

  .research-index__body {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.4rem;
    padding: 1rem 1.05rem 0.9rem;
    min-width: 0;
  }

  .research-index__subtitle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .research-index__foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    width: 100%;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .research-index__name {
    position: relative;
    width: max-content;
    max-width: 100%;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    color: var(--fg);
  }

  .research-index__name::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.08em;
    width: 100%;
    height: 1px;
    background: var(--color-pink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.32s ease;
  }

  .research-index__card:hover .research-index__name::after,
  .research-index__card:focus-visible .research-index__name::after {
    transform: scaleX(1);
  }

  .research-index__summary {
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .research-index__go {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    color: var(--fg-muted);
    border: 1px solid var(--rule);
    border-radius: 50%;
    transition:
      border-color 0.28s ease,
      color 0.28s ease;
  }

  .research-index__card:hover .research-index__go,
  .research-index__card:focus-visible .research-index__go {
    border-color: var(--color-pink);
    color: var(--color-pink);
  }

  @media (max-width: 39.99rem) {
    .research-index__card {
      grid-template-columns: 1fr;
    }

    .research-index__media {
      min-height: 11rem;
      aspect-ratio: 16 / 10;
      height: auto;
    }

    .research-index__body {
      padding: 0.95rem 0.95rem 0.85rem;
    }
  }
</style>
