---
import ResearchArticle from '../../components/ResearchArticle.astro';
import { getResearchThread } from '../../lib/content';
import { RESEARCH_THREADS, type ResearchThread } from '../../lib/vocabulary';

export function getStaticPaths() {
  return RESEARCH_THREADS.map((thread) => ({ params: { thread }, props: { thread } }));
}

interface Props {
  thread: ResearchThread;
}

const { thread } = Astro.props;
const entry = await getResearchThread(thread);
---

<ResearchArticle thread={thread} entry={entry} />
