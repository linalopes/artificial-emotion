---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { href } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** Page surface. Light is the default; dark is for immersive moments. */
  theme?: 'light' | 'dark' | 'soft';
  /** Homepage uses the Deep Purple publication bar; other pages stay default. */
  header?: 'default' | 'publication';
  /** Keep experimental pages out of search indexes. */
  noindex?: boolean;
  /**
   * Hide site chrome (header, nav, footer, search).
   * Also applied at runtime when the URL has `?embed=1`, so static
   * production builds of the same HTML can be embedded without a second page.
   */
  embed?: boolean;
}

const siteName = 'Artificial Emotion';

const {
  title,
  description = 'Research into movement, soft mechanisms, kinetic behavior and bodily signals.',
  lang = 'en',
  theme = 'light',
  header = 'default',
  noindex = false,
  embed = false,
} = Astro.props;

const isEmbed = embed || Astro.url.searchParams.get('embed') === '1';

const themeColor =
  header === 'publication' || theme === 'dark' ? '#22113e' : theme === 'soft' ? '#cad8d8' : '#ffffff';

const pageTitle = title ? `${title} — ${siteName}` : siteName;

const favicon = href('/favicon.svg');

// Space Grotesk 300/500 · Inter 300/600 · Courier Prime 400/700
const googleFonts =
  'https://fonts.googleapis.com/css2' +
  '?family=Space+Grotesk:wght@300;500' +
  '&family=Inter:wght@300;600' +
  '&family=Courier+Prime:wght@400;700' +
  '&display=swap';
---

<!doctype html>
<html lang={lang} class:list={[isEmbed && 'embed']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content={theme === 'dark' ? 'dark' : 'light'} />
    <meta name="theme-color" content={themeColor} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href={favicon} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={googleFonts} />
    <script is:inline>
      (function () {
        try {
          if (new URLSearchParams(location.search).get('embed') !== '1') return;
          document.documentElement.classList.add('embed');
          var removeChrome = function () {
            ['.site-header', '.site-footer', '.site-search'].forEach(function (sel) {
              document.querySelectorAll(sel).forEach(function (el) {
                el.remove();
              });
            });
          };
          if (document.body) removeChrome();
          else document.addEventListener('DOMContentLoaded', removeChrome);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={theme === 'light' ? undefined : `theme-${theme}`}>
    {!isEmbed && <SiteHeader variant={header} />}
    <slot />
    {!isEmbed && <SiteFooter />}
    {!isEmbed && <SiteSearch />}
  </body>
</html>

<style is:global>
  /* Static production HTML is shared for ?embed=1; hide chrome before first paint. */
  html.embed .site-header,
  html.embed .site-footer,
  html.embed .site-search {
    display: none !important;
  }
</style>
