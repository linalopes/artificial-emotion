---
const supporters = [
  {
    id: 'ift',
    lines: ['Institute for Future Technologies (IFT)', 'De Vinci Higher Education'],
  },
  {
    id: 'sotai',
    lines: ['School of Tomorrow’s AI'],
  },
];
---

<section class="about" id="about" aria-labelledby="about-heading">
  <div class="about__inner">
    <h2 class="about__heading" id="about-heading">About Artificial Emotion</h2>

    <div class="about__copy">
      <p>
        Artificial Emotion is an ongoing artistic research project by Lina Lopes, currently being
        developed as part of an artist residency at the Institute for Future Technologies (IFT), De
        Vinci Higher Education, Paris.
      </p>
      <p>
        The research explores movement, soft mechanisms, sensing and bodily signals as ways of
        producing expressive mechanical behavior. It develops through kinetic prototypes, material
        studies, physiological sensing experiments, fabrication tests and public research formats.
      </p>
    </div>

    <div class="about__support">
      <h3 class="about__support-heading">Supported by</h3>
      <ul class="support">
        {
          supporters.map((item) => (
            <li class="support__item">
              <span class="support__logo" data-support-logo={item.id} aria-hidden="true"></span>
              <span class="support__name">
                {item.lines.map((line) => (
                  <span class="support__line">{line}</span>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    width: 100%;
    background: var(--color-white);
  }

  .about__inner {
    display: grid;
    gap: var(--space-5);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-6) var(--page-gutter);
  }

  .about__heading {
    font-size: clamp(1.65rem, 1.2rem + 1.4vw, 2.25rem);
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .about__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 46ch;
  }

  .about__copy p {
    max-width: none;
    line-height: var(--leading-body);
  }

  .about__support {
    display: grid;
    gap: var(--space-3);
  }

  .about__support-heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--weight-mono-regular);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .support {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .support__item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    max-width: none;
  }

  .support__logo {
    display: block;
    width: 4.5rem;
    height: 3rem;
    background: color-mix(in srgb, var(--color-gray-green) 38%, var(--color-white));
    border: 1px solid var(--color-gray-green);
    border-radius: 2px;
  }

  .support__name {
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
  }

  .support__line {
    display: block;
  }

  @media (min-width: 48rem) {
    .about__inner {
      grid-template-columns: minmax(12rem, 0.34fr) minmax(0, 0.66fr);
      align-items: start;
      column-gap: var(--space-6);
      row-gap: var(--space-6);
      padding-block: var(--space-7) var(--space-6);
    }

    .about__heading {
      grid-column: 1;
      grid-row: 1;
    }

    .about__copy {
      grid-column: 2;
      grid-row: 1;
    }

    .about__support {
      grid-column: 2;
      grid-row: 2;
    }

    .support {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-5);
    }
  }

  @media (min-width: 68.75rem) {
    .about__inner {
      grid-template-columns: minmax(14rem, 0.3fr) minmax(0, 0.7fr);
    }

    .about__copy {
      max-width: 52ch;
    }
  }
</style>
