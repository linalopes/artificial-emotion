---
import { collectionPath, href, researchPath } from '../lib/paths';
import { COLLECTIONS, COLLECTION_LABELS } from '../lib/vocabulary';

const navItems = [
  { label: 'Research', path: researchPath() },
  ...COLLECTIONS.map((c) => ({ label: COLLECTION_LABELS[c], path: collectionPath(c) })),
];

const current = Astro.url.pathname;
const isCurrent = (path: string) => current === path || current.startsWith(path);
---

<header class="site-header">
  <a class="site-header__title" href={href('/')}>Artificial Emotion</a>
  <nav class="site-header__nav" aria-label="Main">
    {
      navItems.map(({ label, path }) => (
        <a href={path} aria-current={isCurrent(path) ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-4) var(--page-gutter);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__title {
    font-family: var(--font-title);
    font-weight: var(--weight-title-medium);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-title);
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .site-header__nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-muted);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
