---
/**
 * Full-text search overlay. Pagefind assets load only after the user opens it.
 */
---

<div class="site-search" id="site-search" data-site-search data-pagefind-ignore="all" hidden>
  <div class="site-search__backdrop" data-search-close tabindex="-1"></div>

  <div
    class="site-search__panel"
    data-search-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="site-search-title"
  >
    <div class="site-search__bar">
      <h2 id="site-search-title" class="visually-hidden">Search the research notebook</h2>
      <label class="visually-hidden" for="site-search-input">Search</label>
      <input
        id="site-search-input"
        class="site-search__input"
        data-search-input
        type="search"
        placeholder="Search the research notebook…"
        autocomplete="off"
        enterkeyhint="search"
      />
      <button class="site-search__close" type="button" data-search-close>
        Close
      </button>
    </div>

    <p class="site-search__status" data-search-status aria-live="polite">
      Search across studies, notes, references, events and research threads.
    </p>

    <ol class="site-search__results" data-search-results role="listbox" aria-label="Search results"></ol>
  </div>
</div>

<script>
  import { mountSiteSearch } from '../scripts/site-search';
  mountSiteSearch();
</script>

<style is:global>
  body.is-search-open {
    overflow: hidden;
  }

  .site-search[hidden] {
    display: none;
  }

  .site-search {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
  }

  .site-search__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-deep-purple) 16%, transparent);
  }

  .site-search__panel {
    position: relative;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    align-self: stretch;
    width: min(44rem, 100%);
    max-height: 100dvh;
    margin-inline: auto;
    padding: var(--space-4) var(--page-gutter) var(--space-5);
    background: var(--color-white);
    color: var(--color-deep-purple);
    overflow: hidden;
  }

  .site-search__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: end;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .site-search__input {
    width: 100%;
    min-width: 0;
    padding: 0.15rem 0 0.4rem;
    border: 0;
    border-bottom: 1px solid var(--color-gray-green);
    border-radius: 0;
    background: transparent;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(1.45rem, 1.15rem + 1.1vw, 2rem);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    color: var(--color-deep-purple);
  }

  .site-search__input::placeholder {
    color: color-mix(in srgb, var(--color-deep-purple) 42%, var(--color-white));
  }

  .site-search__input::-webkit-search-decoration,
  .site-search__input::-webkit-search-cancel-button,
  .site-search__input::-webkit-search-results-button,
  .site-search__input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .site-search__input:focus {
    outline: none;
    border-bottom-color: var(--color-link);
    box-shadow: inset 0 -1px 0 var(--color-link);
  }

  .site-search__close {
    padding: 0.2rem 0;
    border: 0;
    background: transparent;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    cursor: pointer;
    text-decoration: none;
  }

  .site-search__close:hover,
  .site-search__close:focus-visible {
    color: var(--color-deep-purple);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--color-link);
  }

  .site-search__status {
    margin: 0;
    padding-block: 0.85rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-deep-purple) 48%, var(--color-white));
  }

  .site-search__results {
    list-style: none;
    padding: 0 0 var(--space-3);
    margin: 0;
    min-height: 0;
    overflow: auto;
  }

  .site-search__item {
    position: relative;
    display: grid;
    gap: 0.42rem;
    max-width: none;
    padding: 1.2rem 0.2rem 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .site-search__item:first-child {
    margin-top: 0.35rem;
  }

  .site-search__item.is-active,
  .site-search__item:has(.site-search__title:focus-visible) {
    box-shadow: inset 2px 0 0 var(--color-pink);
  }

  .site-search__type {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .site-search__title {
    position: static;
    display: inline-block;
    width: max-content;
    max-width: 100%;
    margin: 0;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.6rem);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    color: var(--color-deep-purple);
    text-decoration: none;
  }

  .site-search__title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .site-search__title:hover,
  .site-search__title:focus-visible {
    color: var(--color-deep-purple);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
    text-decoration-color: var(--color-pink);
  }

  .site-search__excerpt {
    max-width: 52ch;
    margin: 0.1rem 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: var(--weight-body-light);
    line-height: 1.5;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .site-search__excerpt mark {
    background: color-mix(in srgb, var(--color-gray-green) 62%, var(--color-white));
    color: var(--color-deep-purple);
    padding: 0 0.06em;
  }

  .site-search__meta {
    display: grid;
    gap: 0.18rem;
    margin: 0.2rem 0 0;
    max-width: 100%;
  }

  .site-search__thread,
  .site-search__tags,
  .site-search__date {
    margin: 0;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-deep-purple) 52%, var(--color-white));
    overflow-wrap: anywhere;
  }

  @media (min-width: 40rem) {
    .site-search {
      padding-block: 7vh;
    }

    .site-search__panel {
      align-self: start;
      max-height: min(44rem, 86dvh);
      padding: var(--space-5) var(--space-5) var(--space-4);
      border: 1px solid var(--color-gray-green);
    }
  }
</style>
