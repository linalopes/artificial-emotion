---
import type { GalleryItem } from '../lib/cloudinary';
import { mediaSrc } from '../lib/paths';

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const total = items.length;
const interactive = total > 1;

const thumbSrc = (item: GalleryItem) => {
  if (item.type === 'image') return mediaSrc(item.src);
  return item.poster ? mediaSrc(item.poster) : undefined;
};
---

{
  total > 0 && (
    <section
      class="research-gallery"
      data-pagefind-ignore
      data-research-gallery={interactive ? '' : undefined}
      data-count={total}
      tabindex={interactive ? 0 : undefined}
      aria-roledescription={interactive ? 'carousel' : undefined}
      aria-label="Gallery"
    >
      <div class="research-gallery__stage" data-gallery-stage>
        <div class="research-gallery__slides">
          {items.map((item, index) => {
            const caption = item.caption?.trim() || undefined;
            const videoAlt = item.type === 'video' ? item.alt?.trim() || caption : undefined;
            return (
              <figure
                class:list={['research-gallery__slide', index === 0 && 'is-active']}
                data-slide
                hidden={index !== 0}
                aria-hidden={index !== 0 ? true : undefined}
              >
                {item.type === 'image' ? (
                  <img src={mediaSrc(item.src)} alt={item.alt} />
                ) : (
                  <video
                    src={mediaSrc(item.src)}
                    poster={item.poster ? mediaSrc(item.poster) : undefined}
                    controls
                    playsinline
                    preload="metadata"
                    aria-label={videoAlt}
                  ></video>
                )}
                {caption && <figcaption>{caption}</figcaption>}
              </figure>
            );
          })}
        </div>

        {
          interactive && (
            <div class="research-gallery__bar">
              <button type="button" class="research-gallery__nav" data-gallery-prev>
                Previous
              </button>
              <p class="research-gallery__counter" data-gallery-live aria-live="off">
                <span data-gallery-current>1</span>
                <span aria-hidden="true"> / </span>
                <span class="visually-hidden">of</span>
                {total}
              </p>
              <button type="button" class="research-gallery__nav" data-gallery-next>
                Next
              </button>
            </div>
          )
        }
      </div>

      {
        interactive && (
          <ul class="research-gallery__thumbs" aria-label="Gallery thumbnails">
            {items.map((item, index) => {
              const src = thumbSrc(item);
              const label =
                item.caption?.trim() ||
                (item.type === 'image' ? item.alt.trim() : item.alt?.trim()) ||
                `Item ${index + 1}`;
              return (
                <li>
                  <button
                    type="button"
                    class="research-gallery__thumb"
                    data-thumb
                    aria-current={index === 0 ? 'true' : undefined}
                    aria-label={label}
                  >
                    {src ? (
                      <img src={src} alt="" />
                    ) : (
                      <span class="research-gallery__thumb-fallback">Video</span>
                    )}
                  </button>
                </li>
              );
            })}
          </ul>
        )
      }
    </section>
  )
}

<script>
  import { mountResearchGallery } from '../scripts/research-gallery';
  document.querySelectorAll<HTMLElement>('[data-research-gallery]').forEach(mountResearchGallery);
</script>

<style>
  .research-gallery {
    position: relative;
    min-width: 0;
    padding-block: var(--space-4);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 20%, transparent) 0%,
      var(--color-white) 16%,
      var(--color-white) 84%,
      color-mix(in srgb, var(--color-white) 20%, transparent) 100%
    );
    outline: none;
  }

  .research-gallery:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
  }

  .research-gallery__stage {
    touch-action: pan-y;
  }

  .research-gallery__slides {
    position: relative;
  }

  .research-gallery__slide {
    margin: 0;
  }

  .research-gallery[data-ready] .research-gallery__slides {
    display: grid;
  }

  .research-gallery[data-ready] .research-gallery__slide {
    grid-area: 1 / 1;
  }

  .research-gallery__slide:not(.is-active) {
    display: none;
  }

  .research-gallery[data-ready] .research-gallery__slide:not(.is-active) {
    display: block;
    visibility: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .research-gallery[data-ready] .research-gallery__slide.is-active {
    visibility: visible;
    z-index: 1;
  }

  .research-gallery__slide img,
  .research-gallery__slide video {
    display: block;
    width: 100%;
    height: 32rem;
    max-height: 32rem;
    object-fit: contain;
    background: color-mix(in srgb, var(--color-gray-green) 28%, var(--color-white));
  }

  .research-gallery__slide figcaption {
    max-width: none;
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .research-gallery__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .research-gallery__nav {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--weight-mono-regular);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .research-gallery__nav:first-of-type {
    justify-self: start;
  }

  .research-gallery__nav:last-of-type {
    justify-self: end;
  }

  .research-gallery__nav:hover,
  .research-gallery__nav:focus-visible {
    color: var(--color-link);
  }

  .research-gallery__counter {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    text-align: center;
  }

  .research-gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  .research-gallery__thumb {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-gray-green) 80%, var(--color-deep-purple));
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-gray-green) 35%, var(--color-white));
    cursor: pointer;
    overflow: hidden;
  }

  .research-gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .research-gallery__thumb-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .research-gallery__thumb[aria-current='true'] {
    border-color: var(--color-deep-purple);
  }

  @media (max-width: 39.99rem) {
    .research-gallery__slide img,
    .research-gallery__slide video {
      height: 22rem;
      max-height: 22rem;
    }

    .research-gallery__thumb {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
