---
/**
 * Editorial archive card used on Tag pages.
 * Same listing language as collection indexes, without copying each page.
 */
interface Props {
  href: string;
  title: string;
  cover?: string;
  coverFit?: 'cover' | 'contain';
  kicker?: string;
  subtitle?: string;
  lede?: string;
  meta?: string;
  datetime?: string;
}

const {
  href,
  title,
  cover,
  coverFit = 'cover',
  kicker,
  subtitle,
  lede,
  meta,
  datetime,
} = Astro.props;
---

<a class="archive-card" href={href}>
  {
    cover ? (
      <img
        class:list={['archive-card__media', coverFit === 'contain' && 'archive-card__media--contain']}
        src={cover}
        alt=""
      />
    ) : (
      <span class="archive-card__media archive-card__media--ph" aria-hidden="true"></span>
    )
  }

  <span class="archive-card__body">
    {kicker && <span class="archive-card__kicker">{kicker}</span>}
    <span class="archive-card__name">{title}</span>
    {subtitle && <span class="archive-card__subtitle">{subtitle}</span>}
    {
      meta &&
        (datetime ? (
          <time class="archive-card__meta" datetime={datetime}>
            {meta}
          </time>
        ) : (
          <span class="archive-card__meta">{meta}</span>
        ))
    }
    {lede && <span class="archive-card__lede">{lede}</span>}
    <span class="archive-card__foot">
      <span class="archive-card__go" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="12" height="12">
          <path
            d="M7 12h10M13 7l5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </span>
  </span>
</a>

<style>
  .archive-card {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.35fr) minmax(0, 0.65fr);
    min-height: 12.5rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--color-white) 86%, transparent);
    border: 1px solid var(--color-gray-green);
    border-radius: 2px;
    overflow: hidden;
  }

  .archive-card:hover,
  .archive-card:focus-visible {
    color: inherit;
  }

  .archive-card:focus-visible {
    outline: 2px solid var(--color-pink);
    outline-offset: 3px;
  }

  .archive-card__media {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 12.5rem;
    object-fit: cover;
    align-self: stretch;
  }

  .archive-card__media--contain {
    object-fit: contain;
    box-sizing: border-box;
    padding: 1.15rem 1.25rem;
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--color-gray-green) 55%, var(--color-white)) 0%,
        color-mix(in srgb, var(--color-turquoise) 12%, var(--color-white)) 100%
      );
  }

  .archive-card__media--ph {
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--color-gray-green) 55%, var(--color-white)) 0%,
        color-mix(in srgb, var(--color-turquoise) 12%, var(--color-white)) 100%
      );
  }

  .archive-card__body {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.4rem;
    padding: 1rem 1.05rem 0.9rem;
    min-width: 0;
  }

  .archive-card__kicker,
  .archive-card__subtitle,
  .archive-card__meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .archive-card__kicker {
    color: var(--color-link);
  }

  .archive-card__subtitle,
  .archive-card__meta {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .archive-card__name {
    position: relative;
    width: max-content;
    max-width: 100%;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    color: var(--fg);
  }

  .archive-card__name::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.08em;
    width: 100%;
    height: 1px;
    background: var(--color-pink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.32s ease;
  }

  .archive-card:hover .archive-card__name::after,
  .archive-card:focus-visible .archive-card__name::after {
    transform: scaleX(1);
  }

  .archive-card__lede {
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .archive-card__foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    width: 100%;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .archive-card__go {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    color: var(--fg-muted);
    border: 1px solid var(--rule);
    border-radius: 50%;
    transition:
      border-color 0.28s ease,
      color 0.28s ease;
  }

  .archive-card:hover .archive-card__go,
  .archive-card:focus-visible .archive-card__go {
    border-color: var(--color-pink);
    color: var(--color-pink);
  }

  @media (max-width: 39.99rem) {
    .archive-card {
      grid-template-columns: 1fr;
    }

    .archive-card__media {
      min-height: 11rem;
      aspect-ratio: 16 / 10;
      height: auto;
    }

    .archive-card__body {
      padding: 0.95rem 0.95rem 0.85rem;
    }
  }
</style>
