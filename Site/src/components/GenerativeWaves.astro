---
/**
 * Tomorrow's Waves — p5.js 2D sketch of seeded ribbons, mesh, and threads.
 * The client script (and p5 itself) is bundled only for pages that render
 * this component. Parameters: src/lib/waves.config.ts.
 *
 * Intended for the White surface (.theme-light). Canvas-only dark mode
 * (debug "deep purple") does not restyle the document.
 */
interface Props {
  /** Accessible description of the figure. */
  label?: string;
  /**
   * "block": a sized figure in the flow (own aspect ratio).
   * "fill": stretches to its positioned parent, as a background layer.
   */
  mode?: 'block' | 'fill';
}

const {
  label = "Tomorrow's Waves: generative ribbons crossing the field",
  mode = 'block',
} = Astro.props;
---

<figure class:list={['waves', `waves--${mode}`]} data-waves role="img" aria-label={label}>
  <figcaption class="visually-hidden">{label}</figcaption>
</figure>

<script>
  import { mountWaves } from '../scripts/waves-client';
  document.querySelectorAll<HTMLElement>('[data-waves]').forEach(mountWaves);
</script>

<style is:global>
  .waves {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--color-white);
    touch-action: none;
  }

  .waves--block {
    aspect-ratio: 1 / 1;
    max-height: calc(100dvh - 8rem);
  }

  @media (min-width: 40rem) {
    .waves--block {
      aspect-ratio: 16 / 10;
    }
  }

  .waves--fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .waves canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .waves-debug {
    position: absolute;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 10;
    width: 260px;
    max-width: calc(100% - 32px);
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg);
    background: color-mix(in srgb, var(--color-white) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--rule);
    border-radius: 4px;
    transition: opacity 0.3s, transform 0.3s;
  }

  .waves-debug.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }

  .waves-debug__title {
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: 20px;
    letter-spacing: -0.01em;
    margin: 0 0 4px;
    color: var(--fg);
  }

  .waves-debug__sub {
    opacity: 0.6;
    margin: 0 0 14px;
  }

  .waves-debug__row {
    display: grid;
    grid-template-columns: 78px 1fr 34px;
    align-items: center;
    gap: 8px;
    margin: 8px 0;
  }

  .waves-debug__row output {
    text-align: right;
    opacity: 0.7;
  }

  .waves-debug input[type='range'] {
    width: 100%;
    accent-color: var(--color-pink);
  }

  .waves-debug__toggles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 10px;
    margin: 12px 0;
  }

  .waves-debug__toggles label {
    display: flex;
    gap: 6px;
    align-items: center;
    cursor: pointer;
  }

  .waves-debug input[type='checkbox'] {
    accent-color: var(--color-pink);
  }

  .waves-debug__btns {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .waves-debug button,
  .waves-debug__show {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--fg);
    border-radius: 4px;
    padding: 6px 10px;
    cursor: pointer;
  }

  .waves-debug button:hover,
  .waves-debug__show:hover {
    background: var(--color-pink);
    border-color: var(--color-pink);
    color: var(--color-deep-purple);
  }

  .waves-debug__accent {
    background: var(--color-turquoise);
    border-color: var(--color-turquoise);
    color: var(--color-deep-purple);
  }

  .waves-debug__accent:hover {
    background: var(--color-pink);
    border-color: var(--color-pink);
  }

  .waves-debug__keys {
    margin: 12px 0 0;
    opacity: 0.55;
    line-height: 1.5;
  }

  .waves-debug__show {
    position: absolute;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 9;
    background: color-mix(in srgb, var(--color-white) 86%, transparent);
  }
</style>
