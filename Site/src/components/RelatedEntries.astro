---
import { resolveRelated, type RelatedRef, type ResolvedRelated } from '../lib/content';

interface Props {
  /** Outbound `related` refs. Resolved here unless `items` is provided. */
  refs?: readonly RelatedRef[];
  /** Already-resolved entries (used for derived backlinks). */
  items?: readonly ResolvedRelated[];
  /** Visible heading. Related = outbound; Referenced by = inbound. */
  heading?: string;
  headingId?: string;
  /** Used only for build-log warnings about missing targets. */
  from?: string;
}

const {
  refs = [],
  items,
  heading = 'Related',
  headingId = heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
  from,
} = Astro.props;

const list = items ?? (refs.length > 0 ? await resolveRelated(refs, from) : []);
---

{
  list.length > 0 && (
    <section class="related" aria-labelledby={headingId}>
      <h2 id={headingId} class="label">{heading}</h2>
      <ul class="related__list">
        {list.map((item) => (
          <li>
            <a href={item.href}>{item.title}</a>
            <span class="label related__type">{item.typeLabel}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .related__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .related__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .related__type {
    font-size: var(--text-xs);
  }
</style>
