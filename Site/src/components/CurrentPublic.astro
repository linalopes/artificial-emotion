---
import { getEntry } from 'astro:content';
import { formatDateShort, isoDate } from '../lib/content';
import { entryPath, mediaSrc } from '../lib/paths';

const eventEntry = await getEntry('events', 'open-research-studio');
const event = eventEntry && !eventEntry.data.draft ? eventEntry : undefined;
---

<section class="band" aria-labelledby="current-heading">
  <div class="band__inner">
    <h2 class="band__heading" id="current-heading">Current / Public</h2>

    <div class="current">
      {
        event && (
          <a class="ed-card" href={entryPath('events', event.id)}>
            {event.data.cover ? (
              <img class="ed-card__media" src={mediaSrc(event.data.cover)} alt="" />
            ) : (
              <span class="ed-card__media ed-card__media--event" aria-hidden="true"></span>
            )}
            <span class="ed-card__body">
              <span class="ed-card__tag">Event</span>
              <span class="ed-card__title">
                {event.data.title}
                <time class="ed-card__date" datetime={isoDate(event.data.date)}>
                  {formatDateShort(event.data.date)}
                </time>
              </span>
              {
                event.data.lede && (
                  <span class="ed-card__lede">{event.data.lede}</span>
                )
              }
              <span class="ed-card__go" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="12" height="12">
                  <path
                    d="M7 12h10M13 7l5 5-5 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
            </span>
          </a>
        )
      }

      <article class="ed-card ed-card--soon" aria-label="Artificial Emotion studio film, coming soon">
        <span class="ed-card__media ed-card__media--film" aria-hidden="true">
          <span class="ed-card__play">
            <svg viewBox="0 0 24 24" width="14" height="14">
              <path d="M9 7.5v9l8-4.5-8-4.5z" fill="currentColor"></path>
            </svg>
          </span>
        </span>
        <span class="ed-card__body">
          <span class="ed-card__title">
            Artificial Emotion
            <span class="ed-card__date">Studio Film</span>
          </span>
          <span class="ed-card__lede ed-card__lede--meta">YouTube / ——:——</span>
          <span class="ed-card__soon">Coming soon</span>
        </span>
      </article>
    </div>
  </div>
</section>

<style>
  .band {
    width: 100%;
  }

  .band__inner {
    display: grid;
    gap: var(--space-4);
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .band__heading {
    font-size: clamp(1.65rem, 1.2rem + 1.4vw, 2.25rem);
    letter-spacing: -0.03em;
  }

  .current {
    display: grid;
    gap: 0.75rem;
  }

  .ed-card {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.4fr) minmax(0, 0.6fr);
    min-height: 10.5rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--color-white) 86%, transparent);
    border: 1px solid var(--color-gray-green);
    border-radius: 2px;
    overflow: hidden;
  }

  .ed-card:hover .ed-card__go {
    border-color: var(--fg);
    color: var(--fg);
  }

  .ed-card--soon {
    cursor: default;
  }

  .ed-card__media {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 10.5rem;
    object-fit: cover;
    align-self: stretch;
  }

  .ed-card__media--event {
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-gray-green) 55%, var(--color-white)) 0%,
        color-mix(in srgb, var(--color-turquoise) 12%, var(--color-white)) 100%
      );
  }

  .ed-card__media--film {
    position: relative;
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--color-deep-purple) 18%, var(--color-gray-green)) 0%,
        color-mix(in srgb, var(--color-pink) 14%, var(--color-white)) 55%,
        color-mix(in srgb, var(--color-turquoise) 10%, var(--color-white)) 100%
      );
  }

  .ed-card__play {
    position: absolute;
    inset: 0;
    width: 2.35rem;
    height: 2.35rem;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-deep-purple) 42%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-white) 80%, transparent);
    border-radius: 50%;
  }

  .ed-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.7rem;
    grid-template-rows: auto auto auto 1fr;
    gap: 0.35rem 0.65rem;
    padding: 0.9rem 0.95rem 0.8rem;
    min-width: 0;
  }

  .ed-card__tag,
  .ed-card__soon,
  .ed-card__lede--meta {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .ed-card__title {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-title);
    font-weight: var(--weight-title-light);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
  }

  .ed-card__date {
    display: block;
    font-size: 0.92em;
  }

  .ed-card__lede {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
    max-width: 36ch;
  }

  .ed-card__lede--meta {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .ed-card__soon {
    grid-column: 1;
    align-self: end;
    margin-top: 0.5rem;
  }

  .ed-card__go {
    grid-column: 2;
    grid-row: 4;
    align-self: end;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    margin-top: 0.55rem;
    color: var(--fg-muted);
    border: 1px solid var(--rule);
    border-radius: 50%;
  }

  @media (min-width: 48rem) {
    .current {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
